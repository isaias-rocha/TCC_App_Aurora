<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================================================================
         PERMISSÕES: INTERNET E ESTADO DE REDE (COMUNICAÇÃO COM O XAMPP/MYSQL)
         ========================================================================= -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- =========================================================================
         PERMISSÕES: NOTIFICAÇÕES (ANDROID 13+ / API 33+)
         ========================================================================= -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- =========================================================================
         PERMISSÕES: GEOLOCALIZAÇÃO (GPS)
         ========================================================================= -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- =========================================================================
         PERMISSÕES: SERVIÇOS EM PRIMEIRA PLANO (BLE E RASTREAMENTO EM SEGUNDO PLANO)
         ========================================================================= -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- =========================================================================
         PERMISSÕES: BLUETOOTH LOW ENERGY (ANDROID 12+ / API 31+)
         ========================================================================= -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Permissões Bluetooth Legadas (Android 11 e inferior) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- =========================================================================
         PERMISSÕES: RECURSOS FÍSICOS DO DISPOSITIVO (VIBRAÇÃO/FEEDBACK TÁTIL)
         ========================================================================= -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Declara que o aplicativo exige suporte a hardware Bluetooth Low Energy (BLE) -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aurora"
        android:usesCleartextTraffic="true"> <!-- Permite tráfego HTTP local para desenvolvimento no XAMPP -->

        <!-- =========================================================================
             SERVIÇOS DE SEGUNDO PLANO
             ========================================================================= -->
        <!-- Serviço responsável por escutar o botão físico do ESP32 via BLE/Wi-Fi -->
        <service
            android:name=".infra.ble.AuroraBleService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- =========================================================================
             TELA INICIAL (SPLASH SCREEN)
             ========================================================================= -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Aurora">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- =========================================================================
             TELAS DE AUTENTICAÇÃO E CONTA
             ========================================================================= -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.CadastroActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.EsqueceuSenhaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.OtpActivity"
            android:exported="false" />

        <!-- =========================================================================
             TELA PRINCIPAL (HOSPEDA OS FRAGMENTS: HOME, MAPA, SOS, PERFIL, ETC.)
             ========================================================================= -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false" />

        <!-- =========================================================================
             DEMAIS TELAS E DIÁLOGOS AUXILIARES
             ========================================================================= -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.contatos.ContatosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.perfil.PerfilActivity"
            android:exported="false" />
        <activity
            android:name=".ui.planos.PlanosAssinaturaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.config.ConfigActivity"
            android:exported="false" />
        <activity
            android:name=".ui.acessibilidade.AcessibilidadeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.historico.HistoricoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.perfil.InfoPessoaisActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.solicitacao.SolicitacaoAmizadeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.contatos.AdicionarContatoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.sos.SeletorEmergencia"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>
</manifest>