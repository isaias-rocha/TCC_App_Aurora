<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar_conversa"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/colorSurfaceVariant"
            android:padding="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_perfil2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp" />

        <!-- Indicador Online -->
        <View
            android:id="@+id/view_status_online"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@android:drawable/presence_online"
            app:layout_constraintBottom_toBottomOf="@id/iv_avatar_conversa"
            app:layout_constraintEnd_toEndOf="@id/iv_avatar_conversa" />

        <!-- Nome do Contato/Grupo -->
        <TextView
            android:id="@+id/tv_nome_conversa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@id/iv_avatar_conversa"
            app:layout_constraintTop_toTopOf="@id/iv_avatar_conversa"
            tools:text="Usuário" />

        <!-- Horário -->
        <TextView
            android:id="@+id/tv_hora_conversa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Aurora.Body"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_nome_conversa"
            tools:text="07:30" />

        <!-- Última Mensagem -->
        <TextView
            android:id="@+id/tv_ultima_mensagem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Aurora.Body"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_avatar_conversa"
            app:layout_constraintEnd_toStartOf="@id/tv_badge_nao_lidas"
            app:layout_constraintStart_toEndOf="@id/iv_avatar_conversa"
            app:layout_constraintTop_toBottomOf="@id/tv_nome_conversa"
            tools:text="Olá, tudo bem?" />

        <!-- Badge de Mensagens Não Lidas -->
        <TextView
            android:id="@+id/tv_badge_nao_lidas"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_circulo"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Aurora.Body"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tv_ultima_mensagem"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_ultima_mensagem"
            tools:text="1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>