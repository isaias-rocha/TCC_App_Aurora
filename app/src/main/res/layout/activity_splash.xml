<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tela_splash"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".ui.splash.SplashActivity">

    <!-- Container central contendo a logo e o progress bar -->
    <LinearLayout
        android:id="@+id/container_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:contentDescription="Logotipo do aplicativo Aurora"
            android:src="@drawable/logo_aurora" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/pb_barra_progresso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="36dp"
            app:trackCornerRadius="4dp" />

    </LinearLayout>

    <!-- Rodapé fixado na parte inferior da tela -->
    <LinearLayout
        android:id="@+id/container_desenvolvedor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_desenvolvido_por"
            style="@style/TextAppearance.Aurora.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desenvolvido por" />

        <ImageView
            android:id="@+id/iv_empresa"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Logotipo da empresa Eagle"
            android:src="@drawable/empresa_eagle" />

    </LinearLayout>

</RelativeLayout>