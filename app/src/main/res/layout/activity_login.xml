<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.auth.LoginActivity">


    <!-- espaçamento externo na tela -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- BOTÃO VOLTAR -->
        <ImageButton android:id="@+id/btn_voltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Voltar para a tela anterior"
            android:focusable="true"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?android:attr/textColorPrimary" />

        <!-- LOGO -->
        <ImageView android:id="@+id/iv_logoAurora"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="36dp"
            android:contentDescription="Logo Aurora"
            android:src="@drawable/logo_aurora_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_voltar" />

        <!-- TÍTULOS -->
        <TextView android:id="@+id/tv_titulo_login"
            style="@style/TextAppearance.Aurora.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Bem-vindo de volta!"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_logoAurora" />

        <!-- SUBTÍTULOS -->
        <TextView android:id="@+id/tv_subtitulo_login"
            style="@style/TextAppearance.Aurora.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Faça login para continuar"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_titulo_login" />

        <!-- CAMPO EMAIL -->
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_email"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:hint="E-mail"
            android:textColorHint="?android:attr/textColorSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitulo_login">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_email"
                style="@style/TextAppearance.Aurora.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:drawableEnd="@drawable/ic_email"
                android:drawableTint="?android:attr/textColorSecondary"
                android:textColor="?android:attr/textColorPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CAMPO EMAIL -->
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/til_senha"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Senha"
            android:textColorHint="?android:attr/textColorSecondary"
            app:endIconMode="password_toggle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_email">

            <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_senha"
                style="@style/TextAppearance.Aurora.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="?android:attr/textColorPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- CHECK - guardar e lembrar os dados na pasta do dispositivo -->
        <CheckBox android:id="@+id/check_lembrarCredenciais"
            style="@style/TextAppearance.Aurora.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lembrar Credenciais"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/btn_logar"
            app:layout_constraintEnd_toStartOf="@id/tv_ir_para_esqueceuSenha"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_senha"
            app:layout_constraintVertical_bias="0.0" />


        <!-- ESQUECEU A SENHA -->
        <TextView android:id="@+id/tv_ir_para_esqueceuSenha"
            style="@style/TextAppearance.Aurora.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Esqueceu a senha?"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/til_senha"
            app:layout_constraintBottom_toTopOf="@id/btn_logar"
            />


        <!-- BOTÕES -->
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_logar"
            style="@style/TextAppearance.Aurora.Body"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="36dp"
            android:backgroundTint="?attr/colorPrimary"
            android:text="Entrar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_ir_para_esqueceuSenha" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_logar_google"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="?attr/colorSurface"
            android:text="Entrar com Google"
            android:textAllCaps="false"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="20dp"
            app:iconTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_logar" />


    <!-- LINK PARA REGISTRO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_logar_google"
            app:layout_constraintVertical_bias="1.0">

            <TextView
                android:id="@+id/tv_ir_para_cadastro_desc"
                style="@style/TextAppearance.Aurora.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Não tem uma conta? "
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_ir_para_cadastro"
                style="@style/TextAppearance.Aurora.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Criar conta"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>