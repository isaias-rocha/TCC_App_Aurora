<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMap"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. MAPA (Fundo ocupando a tela inteira) -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. CAMADA SUPERIOR (Pesquisa + Filtros) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <!-- BARRA DE PESQUISA -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="48dp"
            app:cardBackgroundColor="#1E293B"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#94A3B8" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Pesquisar no mapa..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Menu - FILTROS DE CATEGORIA -->
        <HorizontalScrollView
            android:id="@+id/scrollFiltros"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSearch">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginStart="0dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <Button android:id="@+id/btn_filtro_todos"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#6C5CE7"
                    android:text="Todos"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button android:id="@+id/btn_filtro_rotas"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/on_surface_claro"
                    android:text="Rotas"
                    android:textAllCaps="false"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Button android:id="@+id/btn_filtro_amigos"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/on_surface_claro"
                    android:text="Amigos"
                    android:textAllCaps="false"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <Button android:id="@+id/btn_filtro_grupos"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/on_surface_claro"
                    android:text="Grupos"
                    android:textAllCaps="false"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>


        <!-- BOTÃO FLUTUANTE PARA VOLTAR À MINHA LOCALIZAÇÃO -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="180dp"
            android:contentDescription="Centralizar na Minha Localização"
            app:backgroundTint="#1E293B"
            app:fabCustomSize="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@android:drawable/ic_menu_myplaces"
            app:tint="#6C5CE7" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. EXPANDABLE BOTTOM SHEET (Painel Deslizante estilo Google Maps) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="true"
        app:behavior_peekHeight="170dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <!-- Barra de Arraste Superior (Pill Drag Handle) -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="#475569" />

                <!-- FILTROS DE TRANSPORTE (Carro, A pé, Bicicleta) -->
                <HorizontalScrollView
                    android:id="@+id/scrollTransportModes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnModeCar"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#6C5CE7"
                            android:text="🚗 Carro"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnModeWalk"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#334155"
                            android:text="🚶 A pé"
                            android:textAllCaps="false"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnModeBike"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="#334155"
                            android:text="🚴 Bicicleta"
                            android:textAllCaps="false"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- CABEÇALHO DO CARD (Sempre Visível no Peek) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imgPin"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/ic_menu_mapmode"
                        app:tint="#6C5CE7" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_toStartOf="@id/btnNavigate"
                        android:layout_toEndOf="@id/imgPin"
                        android:orientation="vertical">

                        <!-- Nome do Local / Tempo e Distância ex: "1 min (70 m)" -->
                        <TextView
                            android:id="@+id/tv_nomeDoLocal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Toque em um ponto no mapa"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- Bairro / Endereço / Status -->
                        <TextView
                            android:id="@+id/tv_localizacaoEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Selecione um destino para navegar"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <!-- Coordenadas Geográficas -->
                        <TextView
                            android:id="@+id/tv_coordenadas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Lat: -- | Lon: --"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <!-- Botão Flutuante de Rota -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnNavigate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:contentDescription="Calcular Rota"
                        app:backgroundTint="#6C5CE7"
                        app:fabCustomSize="48dp"
                        app:srcCompat="@android:drawable/ic_menu_directions"
                        app:tint="#FFFFFF" />

                </RelativeLayout>

                <!-- CONTEÚDO EXPANDIDO (Aparece quando o usuário arrasta o BottomSheet para cima) -->
                <LinearLayout
                    android:id="@+id/layoutEtapasExpandido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="16dp"
                        android:background="#334155" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Etapas do Percurso"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEtapasDetalhes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="6dp"
                        android:text="• Deslize para cima para ver as instruções detalhadas após calcular a rota."
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>