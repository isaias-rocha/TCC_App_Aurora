<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_dispositivo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    tools:context="com.equipe1.aurora.ui.dispositivo.DispositivoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- BOTÃO VOLTAR -->
        <ImageButton
            android:id="@+id/btn_voltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnBackground" />

        <!-- TÍTULO DA TELA -->
        <TextView
            style="@style/TextAppearance.Aurora.Title"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Dispositivo Aurora"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_voltar" />

        <!-- CARTÃO DE STATUS DO DISPOSITIVO -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatusDispositivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:srcCompat="@drawable/ic_hardware"
                        app:tint="@color/cor_primaria" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- NOME DO DISPOSITIVO DINÂMICO -->
                        <TextView
                            style="@style/TextAppearance.Aurora.Title"
                            android:id="@+id/txtNomeDispositivo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Localizador Aurora"
                            android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Subtitle"
                            android:id="@+id/txtStatusConexao"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Conectado via BLE"
                            android:textAppearance="@style/TextAppearance.Aurora.Body"
                            android:textColor="@color/cor_segundaria"
                            android:textSize="14sp" />
                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#E2E8F0" />

                <!-- BATERIA E GPS COM ÍCONES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Seção da Bateria -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgBateria"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_bateria"
                            app:tint="@color/cor_primaria" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aurora.Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bateria"
                                android:textAppearance="@style/TextAppearance.Aurora.Body"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />

                            <TextView
                                style="@style/TextAppearance.Aurora.Body"
                                android:id="@+id/txtNivelBateria"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Seção de Sinal GPS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgSinalGps"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_sinal"
                            app:tint="@color/cor_primaria" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.Aurora.Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sinal GPS"
                                android:textAppearance="@style/TextAppearance.Aurora.Body"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />

                            <TextView
                                style="@style/TextAppearance.Aurora.Body"
                                android:id="@+id/txtStatusGps"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ativo"
                                android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E2E8F0" />

                <!-- SEÇÃO DE COORDENADAS (LATITUDE E LONGITUDE) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Aurora.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Latitude"
                            android:textAppearance="@style/TextAppearance.Aurora.Body"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Body"
                            android:id="@+id/txtLatitude"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--.------"
                            android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Aurora.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Longitude"
                            android:textAppearance="@style/TextAppearance.Aurora.Body"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Body"
                            android:id="@+id/txtLongitude"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--.------"
                            android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- CONFIGURAÇÕES E AÇÕES DO HARDWARE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <!-- VER LOCALIZAÇÃO NO MAPA -->
                <TextView
                    style="@style/TextAppearance.Aurora.Subtitle"
                    android:id="@+id/btnVerLocalizacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:drawablePadding="16dp"
                    android:focusable="true"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp"
                    android:text="Ver Localização no Mapa"
                    android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    app:drawableStartCompat="@drawable/ic_localizacao"
                    app:drawableTint="@color/cor_primaria" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="#F1F5F9" />

                <!-- SINCRONIZAR DADOS -->
                <TextView
                    style="@style/TextAppearance.Aurora.Subtitle"
                    android:id="@+id/btnSincronizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:drawablePadding="16dp"
                    android:focusable="true"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp"
                    android:text="Sincronizar Dados Agora"
                    android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="16sp"
                    app:drawableStartCompat="@drawable/ic_sincronizar"
                    app:drawableTint="#94A3B8" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- BOTÃO PARA PAREAR NOVO DISPOSITIVO -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParearDispositivo"
            style="@style/Widget.Aurora.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Parear Novo Dispositivo"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>