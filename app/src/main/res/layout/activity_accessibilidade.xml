<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView principal habilitado para preencher a tela inteira (fillViewport) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/accessibility"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="24dp"
    tools:context=".ui.acessibilidade.AcessibilidadeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- BOTÃO VOLTAR: voltar à página anterior. -->
        <ImageButton
            android:id="@+id/btn_voltar_acessibilidade"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar para a tela anterior"
            android:src="@drawable/ic_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnBackground" />

        <!-- TÍTULO DA TELA: Não precisa de contentDescription manual, pois o TalkBack lê o android:text diretamente. -->
        <TextView
            android:id="@+id/tv_titulo_acessibilidade"
            style="@style/TextAppearance.Aurora.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:text="Acessibilidade"
            android:textColor="?attr/colorOnBackground"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_voltar_acessibilidade" />

        <TextView
            android:id="@+id/tv_subtitulo_acessibilidade"
            style="@style/TextAppearance.Aurora.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ajuste as configurações para uma experiência de uso mais confortável."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_titulo_acessibilidade" />

        <!-- SEÇÃO 1: VISUAL -->
        <TextView
            android:id="@+id/tv_secao_visual"
            style="@style/TextAppearance.Aurora.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:accessibilityHeading="true"
            android:text="VISUAL"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitulo_acessibilidade" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_visual"
            style="@style/Widget.Aurora.SwitchCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_secao_visual"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <!-- ITEM: ALTO CONTRASTE
                     O contêiner (ConstraintLayout) é o elemento focável e clicável.
                     O contentDescription unifica o título e o detalhe em uma única leitura fluida para o TalkBack. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/row_alto_contraste"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="Modo de Alto Contraste. Destaca bordas e aumenta a legibilidade das cores."
                    android:focusable="true"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_alto_contraste"
                        style="@style/TextAppearance.Aurora.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Modo de Alto Contraste"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/switch_alto_contraste"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="16dp"
                        android:text="Destaca bordas e aumenta a legibilidade das cores"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@id/switch_alto_contraste"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_alto_contraste" />

                    <!-- O Switch fica marcado como clickable/focusable=false para evitar que o leitor
                         de tela precise passar duas vezes no mesmo item (no container e na chave). -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_alto_contraste"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:contentDescription="Alternar Modo de Alto Contraste"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Divisor visual (oculto para o leitor de tela para não interromper a navegação) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:alpha="0.1"
                    android:background="?android:attr/textColorSecondary"
                    android:importantForAccessibility="no" />

                <!-- ITEM: REDUZIR ANIMAÇÕES -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/row_reduzir_animacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="Reduzir Animações. Diminui os efeitos visuais e transições de tela."
                    android:focusable="true"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_reduzir_animacoes"
                        style="@style/TextAppearance.Aurora.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Reduzir Animações"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/switch_reduzir_animacoes"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="16dp"
                        android:text="Diminui os efeitos visuais e transições de tela"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@id/switch_reduzir_animacoes"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_reduzir_animacoes" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_reduzir_animacoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:contentDescription="Alternar redução de animações"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Divisor visual -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:alpha="0.1"
                    android:background="?android:attr/textColorSecondary"
                    android:importantForAccessibility="no" />

                <!-- ITEM: TAMANHO DA FONTE -->
                <LinearLayout
                    android:id="@+id/row_tamanho_fonte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_tamanho_fonte"
                        style="@style/TextAppearance.Aurora.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tamanho da Fonte"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_subtitulo_tamanho_fonte"
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ajuste a escala dos textos para facilitar a leitura"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_tamanho_fonte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:contentDescription="Controle deslizante para alterar o tamanho da fonte"
                        android:stepSize="1"
                        android:valueFrom="0"
                        android:valueTo="3"
                        app:tickVisible="true" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SEÇÃO 2: INTERAÇÃO E RESPOSTA -->
        <TextView
            android:id="@+id/tv_secao_interacao"
            style="@style/TextAppearance.Aurora.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="INTERAÇÃO E FEEDBACK"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_visual" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_interacao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_secao_interacao"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <!-- ITEM: FEEDBACK TÁTIL (VIBRAÇÃO) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/row_feedback_tatil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="Vibração. Vibra o celular ao acionar o botão SOS e alertas."
                    android:focusable="true"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_feedback_tatil"
                        style="@style/TextAppearance.Aurora.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Vibração"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toStartOf="@id/switch_feedback_tatil"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="16dp"
                        android:text="Vibra o celular ao acionar o botão SOS e alertas"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@id/switch_feedback_tatil"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_feedback_tatil" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_feedback_tatil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:clickable="false"
                        android:contentDescription="Alternar feedback por vibração"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Divisor visual -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:alpha="0.1"
                    android:background="?android:attr/textColorSecondary"
                    android:importantForAccessibility="no" />

                <!-- ITEM: LEITOR DE TELA (TALKBACK) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/row_leitor_tela"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="Suporte a TalkBack. Otimiza a leitura de voz dos botões e alertas do app."
                    android:focusable="true"
                    android:minHeight="56dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_leitor_tela"
                        style="@style/TextAppearance.Aurora.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:text="Suporte a TalkBack"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/switch_leitor_tela"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="16dp"
                        android:text="Otimiza a leitura de voz dos botões e alertas do app"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@id/switch_leitor_tela"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_leitor_tela" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_leitor_tela"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:clickable="false"
                        android:contentDescription="Alternar otimização para leitor de tela"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>