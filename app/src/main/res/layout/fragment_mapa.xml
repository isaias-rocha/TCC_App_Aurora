<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMap"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. COMPONENTE PRINCIPAL DO MAPA (OSMDROID) -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/mapa_desc_mapa" />

    <!-- 2. CAMADA SUPERIOR (Barra de pesquisa e Filtros horizontais) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <!-- BARRA DE PESQUISA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_pesquisa"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="48dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pesquisa"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <EditText
                    android:id="@+id/et_pesquisa"
                    style="@style/TextAppearance.Aurora.Body"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="postalAddress"
                    android:background="@null"
                    android:hint="@string/mapa_hint_pesquisa"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnVoz"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/mapa_desc_btn_voz"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_circulo_voz"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARROSSEL DE FILTROS -->
        <HorizontalScrollView
            android:id="@+id/scrollFiltros"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_pesquisa">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filtro_todos"
                    style="@style/Widget.Aurora.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/mapa_filtro_todos"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filtro_rotas"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/mapa_filtro_rotas"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filtro_amigos"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/mapa_filtro_amigos"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filtro_grupos"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:text="@string/mapa_filtro_grupos"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- BOTÃO PARA MOSTRAR/OCULTAR ÁREAS DE RISCO -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnToggleRiscos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="240dp"
            android:contentDescription="Mostrar ou ocultar áreas de risco"
            app:backgroundTint="#1E293B"
            app:fabCustomSize="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@android:drawable/ic_dialog_alert"
            app:tint="#EF4444" />

    <!-- 3. BOTÃO MINHA LOCALIZAÇÃO -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMinhaLocalizacao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/mapa_desc_minha_localizacao"
        app:backgroundTint="?attr/colorSurface"
        app:fabCustomSize="48dp"
        app:layout_anchor="@id/bottomSheet"
        app:layout_anchorGravity="top|end"
        app:srcCompat="@drawable/ic_minha_localizacao"
        app:tint="?attr/colorPrimary" />

    <!-- 4. PAINEL INFERIOR DESLIZANTE (BOTTOM SHEET) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="false"
        app:behavior_peekHeight="200dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:strokeWidth="0dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp"/>

                <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                    android:id="@+id/dragHandle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- SEÇÃO 1: CÍRCULOS DE CONTATOS -->
                <LinearLayout
                    android:id="@+id/layoutCirculos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvTituloCirculos"
                            style="@style/TextAppearance.Aurora.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:accessibilityHeading="true"
                            android:text="@string/mapa_titulo_meus_circulos"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGerenciarCirculos"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:contentDescription="@string/mapa_desc_btn_gerenciar_circulos"
                            android:text="@string/mapa_btn_gerenciar"
                            android:textAllCaps="false"
                            android:textColor="?attr/colorPrimary" />
                    </RelativeLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipGroupCirculos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleLine="true"
                                app:singleSelection="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipNovoCirculo"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:text="@string/mapa_btn_novo_circulo"
                                android:textColor="?attr/colorOnSurface"
                                app:chipBackgroundColor="?attr/colorSurface"
                                app:chipIcon="@android:drawable/ic_input_add"
                                app:chipIconTint="?attr/colorOnSurface" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tvCirculoVazio"
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/mapa_circulo_vazio"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMembros"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_membro" />
                </LinearLayout>

                <!-- SEÇÃO 2: INFORMAÇÕES DO LOCAL SELECIONADO -->
                <LinearLayout
                    android:id="@+id/layoutLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/imgPin"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:importantForAccessibility="no"
                            android:src="@android:drawable/ic_menu_mapmode"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:id="@+id/blocoInfoLocal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_toStartOf="@id/btnNavigate"
                            android:layout_toEndOf="@id/imgPin"
                            android:accessibilityLiveRegion="polite"
                            android:focusable="true"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_nomeDoLocal"
                                style="@style/TextAppearance.Aurora.Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/mapa_padrao_nome_local"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_localizacaoEstado"
                                style="@style/TextAppearance.Aurora.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/mapa_padrao_estado_local"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_distanciaTempo"
                                style="@style/TextAppearance.Aurora.Subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/mapa_padrao_distancia_tempo"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_coordenadas"
                                style="@style/TextAppearance.Aurora.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/mapa_padrao_coordenadas"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btnNavigate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/mapa_desc_btn_navigate"
                            app:backgroundTint="?attr/colorPrimary"
                            app:fabCustomSize="48dp"
                            app:srcCompat="@drawable/ic_seguir_destino"
                            app:tint="?attr/colorOnPrimary" />
                    </RelativeLayout>

                    <!-- DETALHES DAS ETAPAS E MODOS DE TRANSPORTE -->
                    <LinearLayout
                        android:id="@+id/layoutEtapasExpandido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="16dp"
                            android:background="?attr/colorOutlineVariant"
                            android:importantForAccessibility="no" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="@string/mapa_titulo_etapas"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEtapasDetalhes"
                            style="@style/TextAppearance.Aurora.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="6dp"
                            android:text="@string/mapa_instrucao_etapas"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVoltarCirculos"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="48dp"
                            android:text="@string/mapa_btn_voltar_circulos"
                            android:textAllCaps="false"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>

            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>