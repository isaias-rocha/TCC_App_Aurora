<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <!-- ESTRUTURA INTERNA DO CARD DE DISPOSITIVO ENCONTRADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- ÍCONE DE HARDWARE / BLUETOOTH -->
        <ImageView
            android:id="@+id/imgIcone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_hardware"
            app:tint="@color/cor_primaria" />

        <!-- INFORMAÇÕES DE NOME E MAC -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeDispositivoBuscar"
                style="@style/TextAppearance.Aurora.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aurora GPS"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMacDispositivoBuscar"
                style="@style/TextAppearance.Aurora.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="MAC: 00:11:22:33:44:55"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- INDICADOR DE SELEÇÃO -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_sincronizar"
            app:tint="@color/cor_primaria" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>