<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_sos"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- BOTÃO VOLTAR -->
            <ImageButton
                android:id="@+id/btn_voltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Voltar para a tela anterior"
                android:focusable="true"
                android:src="@drawable/ic_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?android:attr/textColorPrimary" />

            <!-- Título -->
            <TextView
                android:id="@+id/tv_titulo"
                style="@style/TextAppearance.Aurora.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergência"
                android:textColor="@color/cor_primaria"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_voltar" />

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/tv_subtitulo"
                style="@style/TextAppearance.Aurora.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Precisa de ajuda?"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_titulo" />


            <!-- Botão SOS Circular - container-->
            <FrameLayout
                android:id="@+id/container_sos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:background="@drawable/button_sos"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitulo">

                <!-- Botão SOS Circular - dentro do container-->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sos"
                    android:layout_width="360dp"
                    android:layout_height="360dp"
                    android:layout_gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="SOS"
                    android:contentDescription="Acionar emergência SOS. Mantenha pressionado para enviar o alerta com sua localização."                    android:textColor="#FFFFFF"
                    android:textSize="100sp"
                    app:backgroundTint="@color/vermelho_alerta"
                    app:cornerRadius="200dp" />
            </FrameLayout>


            <!-- Texto Explicativo -->
            <TextView
                android:id="@+id/tv_descricao_sos"
                android:layout_width="0dp"
                style="@style/TextAppearance.Aurora.Body"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="Ao acionar o SOS, sua localização será enviada para seus contatos confiáveis"
                android:textAlignment="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/container_sos" />


            <!-- Botão Fixo de Emergência (Ligar 190, 192, 193) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ligar_emergencia"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_margin="24dp"
                android:text="Ligar para emergência"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:backgroundTint="@color/vermelho_alerta"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_telefone"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_descricao_sos" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
