<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- CABEÇALHO DO PERFIL (Agrupado para leitura contínua no TalkBack) -->
        <LinearLayout
            android:id="@+id/ll_header_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:contentDescription="Perfil do utilizador. Olá, Usuário. Que bom ver-te por aqui."
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Foto de Perfil -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_foto_perfil"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/card"
                android:importantForAccessibility="no"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_perfil2"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <!-- Bloco de Textos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_ola"
                        style="@style/TextAppearance.Aurora.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="Olá, "
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_nome_usuario"
                        style="@style/TextAppearance.Aurora.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="Usuário"
                        android:textColor="@color/cor_primaria"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_subtitulo"
                    style="@style/TextAppearance.Aurora.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:text="Que bom te ver por aqui."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- BARRA DE PESQUISA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_bar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="36dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_header_profile"
            app:strokeColor="@color/cor_primaria"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pesquisa"
                    app:tint="?android:attr/textColorSecondary" />

                <EditText
                    android:id="@+id/et_pesquisa"
                    style="@style/TextAppearance.Aurora.Body"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Pesquisar lugares, amigos..."
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD DO MAPA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_map_preview"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/search_bar">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapa_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/view_mapa_clique_sobreposicao"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="Pré-visualização do mapa interativo. Toca duas vezes para abrir o mapa em ecrã inteiro."
                    android:focusable="true" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TÍTULO SEÇÃO: NAVEGAÇÃO / SEÇÕES (Marcado como cabeçalho de acessibilidade) -->
        <TextView
            android:id="@+id/tv_secoes_title"
            style="@style/TextAppearance.Aurora.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:accessibilityHeading="true"
            android:text="Navegação Rápida"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_map_preview" />

        <!-- MENU HORIZONTAL DE SEÇÕES -->
        <HorizontalScrollView
            android:id="@+id/hsv_secoes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_secoes_title">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Card: Rotas Salvas -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_rotas_salvas"
                    android:layout_width="140dp"
                    android:layout_height="110dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:contentDescription="Rotas Salvas. Acede aos teus trajetos habituais. Toca duas vezes para abrir."
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/cor_primaria"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home"
                            app:tint="@color/cor_primaria" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:importantForAccessibility="no"
                            android:text="Rotas Salvas"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="Seus trajetos"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Círculos -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_secao_circulos"
                    android:layout_width="140dp"
                    android:layout_height="110dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:contentDescription="Círculos. Gestão de grupos de segurança e proteção. Toca duas vezes para abrir."
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/cor_primaria"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_trabalho"
                            app:tint="@color/cor_primaria" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:importantForAccessibility="no"
                            android:text="Círculos"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="Grupos e proteção"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card: Histórico -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_historico"
                    android:layout_width="140dp"
                    android:layout_height="110dp"
                    android:clickable="true"
                    android:contentDescription="Histórico. Registo de alertas, ocorrências e rotas. Toca duas vezes para abrir."
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/cor_primaria"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_circulo_adicionar"
                            app:tint="@color/cor_primaria" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:importantForAccessibility="no"
                            android:text="Histórico"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="Alertas e registros"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- SEÇÃO: MEUS CÍRCULOS -->
        <TextView
            android:id="@+id/tv_circulos_title"
            style="@style/TextAppearance.Aurora.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:accessibilityHeading="true"
            android:gravity="center_vertical"
            android:text="Meus Círculos"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hsv_secoes" />

        <TextView
            android:id="@+id/tv_gerenciar_circulos"
            style="@style/TextAppearance.Aurora.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:clickable="true"
            android:contentDescription="Gerir círculos. Toca duas vezes para administrar os teus grupos de segurança."
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="Gerenciar"
            android:textColor="@color/cor_primaria"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_circulos_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_circulos_title" />

        <HorizontalScrollView
            android:id="@+id/hsv_circulos_usuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_circulos_title">

            <LinearLayout
                android:id="@+id/container_circulos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Círculo Família -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_circulo_familia"
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:contentDescription="Círculo Família, 4 membros ativos. Toca duas vezes para ver detalhes."
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/cor_primaria"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            style="@style/TextAppearance.Aurora.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="Família"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:importantForAccessibility="no"
                            android:text="4 membros ativos"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Círculo Faculdade -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_circulo_faculdade"
                    android:layout_width="150dp"
                    android:layout_height="85dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:contentDescription="Círculo Faculdade, 6 membros ativos. Toca duas vezes para ver detalhes."
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/cor_primaria"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            style="@style/TextAppearance.Aurora.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:text="Faculdade"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:importantForAccessibility="no"
                            android:text="6 membros ativos"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Card Criar Novo Círculo -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_add_circulo"
                    android:layout_width="120dp"
                    android:layout_height="85dp"
                    android:clickable="true"
                    android:contentDescription="Criar ou adicionar novo círculo de segurança. Toca duas vezes para criar."
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/cor_primaria"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_circulo_adicionar"
                            app:tint="@color/cor_primaria" />

                        <TextView
                            style="@style/TextAppearance.Aurora.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:importantForAccessibility="no"
                            android:text="Novo Círculo"
                            android:textColor="@color/cor_primaria"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- SEÇÃO: AMIGOS PRÓXIMOS -->
        <TextView
            android:id="@+id/tv_friends_title"
            style="@style/TextAppearance.Aurora.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:accessibilityHeading="true"
            android:gravity="center_vertical"
            android:text="Amigos Próximos"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hsv_circulos_usuario" />

        <TextView
            android:id="@+id/tv_ver_todos"
            style="@style/TextAppearance.Aurora.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:clickable="true"
            android:contentDescription="Ver lista completa de amigos próximos. Toca duas vezes para abrir."
            android:focusable="true"
            android:gravity="center_vertical"
            android:text="Ver todos"
            android:textColor="@color/cor_primaria"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_friends_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_friends_title" />

        <HorizontalScrollView
            android:id="@+id/hsv_friends"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_friends_title">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:clickable="true"
                    android:contentDescription="Contato 1, localizado a 321 metros de distância. Toca duas vezes para ver localização no mapa."
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_perfil2"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:tint="@color/texto" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:text="Contato 1"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="321 m"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>