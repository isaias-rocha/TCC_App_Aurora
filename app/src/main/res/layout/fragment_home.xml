<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- CABEÇALHO DO PERFIL -->
        <LinearLayout
            android:id="@+id/ll_header_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Foto de Perfil -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_foto_perfil"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/card"
                android:contentDescription="Foto de perfil do usuário"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_perfil2"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <!-- Bloco de Textos (Saudação e Subtítulo) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Linha do Nome ("Olá, " + Nome) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_ola"
                        style="@style/TextAppearance.Aurora.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Olá, "
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_nome_usuario"
                        style="@style/TextAppearance.Aurora.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Usuário"
                        android:textColor="@color/cor_primaria"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Subtítulo abaixo da saudação -->
                <TextView
                    android:id="@+id/tv_subtitulo"
                    style="@style/TextAppearance.Aurora.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Que bom te ver por aqui."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- BARRA DE PESQUISA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_bar"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="36dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_header_profile"
            app:strokeColor="@color/cor_primaria"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pesquisa"
                    app:tint="?android:attr/textColorSecondary" />

                <EditText
                    style="@style/TextAppearance.Aurora.Body"
                    android:id="@+id/et_pesquisa"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Pesquisar lugares, amigos..."
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CARD DO MAPA -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_map_preview"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/search_bar">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- O Mapa ao fundo (ocultado do TalkBack para não focar partes internas do mapa estático) -->
                <org.osmdroid.views.MapView
                    android:id="@+id/mapa_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <!-- Camada invisível interativa para o leitor de tela -->
                <View
                    android:id="@+id/view_mapa_clique_sobreposicao"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:contentDescription="Visualização do mapa. Toque duas vezes para abrir em tela cheia."
                    android:focusable="true" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TÍTULO SEÇÃO: ACESSO RÁPIDO -->
        <TextView
            style="@style/TextAppearance.Aurora.Subtitle"
            android:id="@+id/tv_acesso_rapido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Acesso Rápido"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_map_preview" />

        <!-- LISTA DE ATALHOS: Casa, Trabalho, Adicionar -->
        <LinearLayout
            android:id="@+id/ll_atalhos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_acesso_rapido">

            <!-- Item: Casa -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_acesso_casa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Atalho Casa. Toque duas vezes para adicionar endereço residencial."
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cor_primaria"
                app:strokeWidth="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_home"
                        app:tint="@color/texto" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Casa"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adicionar"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item: Trabalho -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_acesso_trabalho"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Atalho Trabalho. Toque duas vezes para adicionar endereço profissional."
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cor_primaria"
                app:strokeWidth="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_trabalho"
                        app:tint="@color/texto" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Trabalho"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Adicionar"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Item: Adicionar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_acesso_adicionar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="Adicionar novo atalho de local personalizado."
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cor_primaria"
                app:strokeWidth="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_circulo_adicionar"
                        app:tint="@color/texto" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Adicionar"
                        style="@style/TextAppearance.Aurora.Subtitle"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Novo atalho"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- SEÇÃO: AMIGOS PRÓXIMOS -->
        <TextView
            style="@style/TextAppearance.Aurora.Subtitle"
            android:id="@+id/tv_friends_title"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:text="Amigos Próximos"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_atalhos" />

        <TextView
            style="@style/TextAppearance.Aurora.Subtitle"
            android:id="@+id/tv_ver_todos"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:clickable="true"
            android:contentDescription="Ver lista completa de amigos próximos"
            android:focusable="true"
            android:text="Ver todos"
            android:gravity="center"
            android:textColor="@color/cor_primaria"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/tv_friends_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_friends_title" />

        <HorizontalScrollView
            android:id="@+id/hsv_friends"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_friends_title">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Amigo 1 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:clickable="true"
                    android:contentDescription="Contato, localizado a 321 metros de distância."
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_perfil2"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:tint="@color/texto" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:text="Contato"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/TextAppearance.Aurora.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="321 m"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>