<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/layout_dispositivoAurora"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- CARTÃO DE STATUS DO DISPOSITIVO -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatusDispositivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E2E8F0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:srcCompat="@drawable/ic_hardware"
                    app:tint="@color/cor_primaria" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Localizador Aurora ESP32"
                        android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtStatusConexao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conectado via BLE"
                        android:textAppearance="@style/TextAppearance.Aurora.Body"
                        android:textColor="@color/cor_segundaria"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/cor_primaria" />

            <!-- BATERIA E GPS COM ÍCONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Seção da Bateria -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgBateria"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_bateria"
                        app:tint="@color/cor_primaria" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bateria"
                            android:textAppearance="@style/TextAppearance.Aurora.Body"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtNivelBateria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="85%"
                            android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Seção de Sinal GPS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgSinalGps"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_sinal"
                        app:tint="@color/cor_primaria" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sinal GPS"
                            android:textAppearance="@style/TextAppearance.Aurora.Body"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtStatusGps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ativo (Até 5s)"
                            android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- CONFIGURAÇÕES DO HARDWARE -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchSosFisico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:drawablePadding="16dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="Acionamento por Botão SOS Físico"
                android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                android:textColor="?android:attr/textColorPrimary"
                app:drawableStartCompat="@drawable/ic_notificacao"
                app:drawableTint="#94A3B8" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGpsHardware"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:drawablePadding="16dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="14dp"
                android:text="Transmitir GPS do Hardware"
                android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                android:textColor="?android:attr/textColorPrimary"
                app:drawableStartCompat="@drawable/ic_localizacao"
                app:drawableTint="#94A3B8" />

            <TextView
                android:id="@+id/btnSincronizar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:drawablePadding="16dp"
                android:focusable="true"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp"
                android:text="Sincronizar Dados Agora"
                android:textAppearance="@style/TextAppearance.Aurora.Subtitle"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="16sp"
                app:drawableStartCompat="@drawable/ic_idioma"
                app:drawableTint="#94A3B8" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- BOTÃO PARA PAREAR NOVO DISPOSITIVO -->
    <com.google.android.material.button.MaterialButton
        style="@style/AuroraButtonStyle"
        android:id="@+id/btnParearDispositivo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Parear Novo Dispositivo"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="12dp" />

</LinearLayout>