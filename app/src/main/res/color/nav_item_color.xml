<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- =================================================================== -->
    <!-- ESTADO: ITEM SELECIONADO / ATIVO (CHECKED = TRUE)                  -->
    <!-- =================================================================== -->
    <!-- Define a cor aplicada ao ícone e rótulo do item quando está selecionado -->
    <item android:color="@color/cor_primaria" android:state_checked="true" />

    <!-- =================================================================== -->
    <!-- ESTADO: ITEM NÃO SELECIONADO / INATIVO (CHECKED = FALSE)            -->
    <!-- =================================================================== -->
    <!-- Define a cor neutra aplicada ao ícone e rótulo quando o item está inativo -->
    <item android:color="@color/text_secondary_escuro" android:state_checked="false" />

</selector>