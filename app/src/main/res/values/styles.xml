<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Estilo Principal para Botões Preenchidos (Aurora - Material 3) -->
    <style name="Widget.Aurora.Button" parent="Widget.Material3.Button.ElevatedButton">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Estilo para Cards com Switch (Aurora - Material 3) -->
    <style name="Widget.Aurora.SwitchCard" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <!-- Token M3 para cor de texto sobre superfícies -->
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

</resources>