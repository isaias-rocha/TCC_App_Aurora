<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Estilo Principal para Botões Preenchidos (Aurora) -->
    <style name="Widget.Aurora.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/cor_primaria</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/inter_regular</item>
        <!-- Para adicionar sombra ao botão Material, use elevation -->
        <item name="elevation">4dp</item>
    </style>

    <style name="Widget.Aurora.SwitchCard" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Aurora.Body</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

</resources>