<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- // =================================================================== -->
    <!-- // ESTILO PRINCIPAL PARA BOTÕES PREENCHIDOS (AURORA - MATERIAL 3)     -->
    <!-- // =================================================================== -->
    <style name="Widget.Aurora.Button" parent="Widget.Material3.Button.ElevatedButton">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- // =================================================================== -->
    <!-- // ESTILO PARA CARDS DO APP (AURORA - MATERIAL 3)                    -->
    <!-- // =================================================================== -->
    <style name="Widget.Aurora.SwitchCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- // =================================================================== -->
    <!-- // ESTILO PARA A PÍLULA OVAL DO ITEM SELECIONADO (BOTTOM NAVIGATION)   -->
    <!-- // =================================================================== -->
    <style name="EstiloIndicadorOval" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <!-- // Usa ?attr/colorPrimary para acompanhar a cor escolhida pelo usuário -->
        <item name="color">?attr/colorPrimary</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- // =================================================================== -->
    <!-- // ESTILO COMPLEMENTAR: TIPOGRAFIA DOS RÓTULOS DO MENU                 -->
    <!-- // =================================================================== -->
    <style name="EstiloTextoBottomNav">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>