<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.Theme.Aurora" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Cor do Chip selecionado (substitui o lilás padrão do M3) -->
        <item name="colorSecondaryContainer">@color/cor_chip_selecionado</item>
        <item name="colorOnSecondaryContainer">@color/cor_texto_chip_selecionado</item>

        <!-- Fundo do Chip quando NÃO está selecionado (remove o tom rosado) -->
        <item name="colorSurfaceContainerLow">@color/cor_chip_normal</item>
        <item name="colorSurfaceContainer">@color/cor_chip_normal</item>

        <!-- Borda do Chip quando NÃO está selecionado -->
        <item name="colorOutlineVariant">@color/cor_borda</item>

        <!-- Cores Primárias, Secundárias e Terciárias (Material 3) -->
        <item name="colorPrimary">@color/cor_primaria</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">@color/cor_segundaria</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="colorTertiary">@color/cor_terciaria</item>
        <item name="colorOnTertiary">#FFFFFF</item>

        <!-- // Fundos, Superfícies e Bordas -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- // Cor da borda para TextInputLayouts Outlined e Cards M3 -->
        <item name="colorOutline">@color/cor_borda</item>

        <!-- // Cores de Texto Padrão -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- // Fonte Padrão do Aplicativo -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>

    </style>

    <style name="Theme.Aurora" parent="Base.Theme.Aurora" />

    <!-- // =================================================================== -->
    <!-- // THEME OVERLAYS DINÂMICOS (SOBRESCREVEM A COR EM TODAS AS TELAS)    -->
    <!-- // =================================================================== -->
    <style name="ThemeOverlay.Aurora.Azul" parent="">
        <item name="colorPrimary">@color/aurora_azul</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="ThemeOverlay.Aurora.Verde" parent="">
        <item name="colorPrimary">@color/aurora_verde</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="ThemeOverlay.Aurora.Amarelo" parent="">
        <item name="colorPrimary">@color/aurora_amarelo</item>
        <!-- // Texto escuro sobre amarelo para manter contraste WCAG -->
        <item name="colorOnPrimary">#121216</item>
    </style>

    <style name="ThemeOverlay.Aurora.Vermelho" parent="">
        <item name="colorPrimary">@color/aurora_vermelho</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <!-- // Overlay de Alto Contraste: reforça bordas (colorOutline) -->
    <style name="ThemeOverlay.Aurora.AltoContraste" parent="">
        <item name="colorOutline">?attr/colorPrimary</item>
    </style>

    <!-- // =================================================================== -->
    <!-- // ESTILOS DE TIPOGRAFIA DO DESIGN SYSTEM AURORA (M3)                -->
    <!-- // =================================================================== -->
    <style name="TextAppearance.Aurora.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Aurora.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="TextAppearance.Aurora.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
    </style>

</resources>
