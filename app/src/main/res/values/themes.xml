<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Aurora" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores Primárias, Secundárias e Terciárias (Material 3) -->
        <item name="colorPrimary">@color/cor_primaria</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">@color/cor_segundaria</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="colorTertiary">@color/cor_terciaria</item>
        <item name="colorOnTertiary">#FFFFFF</item>

        <!-- Fundos, Superfícies e Bordas (Chaves Unificadas) -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Cor da borda para TextInputLayouts Outlined e Cards M3 -->
        <item name="colorOutline">@color/cor_borda</item>

        <!-- Cores de Texto Padrão -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Fonte Padrão do Aplicativo -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Theme.Aurora" parent="Base.Theme.Aurora" />

    <!-- Estilos de Tipografia do Design System Aurora (M3) -->
    <style name="TextAppearance.Aurora.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Aurora.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <style name="TextAppearance.Aurora.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <!--Cor contato card-->
    <color name="contatocard">#EAF3F8</color>
    <color name="bordacontatocard">#1B1818</color>

</resources>