<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Aurora" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Cores Primárias e de Destaque -->
        <item name="colorPrimary">@color/cor_primaria</item>
        <item name="colorPrimaryVariant">@color/cor_primaria</item>
        <item name="colorOnPrimary">@color/texto</item>
        <item name="colorSecondary">@color/cor_segundaria</item>
        <item name="colorTertiary">@color/cor_terciaria</item>

        <!-- Fundos e Superfícies (O Card assumirá @color/surface_escuro) -->
        <item name="android:windowBackground">@color/bg_escuro</item>
        <item name="colorSurface">@color/surface_escuro</item>
        <item name="colorOnSurface">@color/on_surface_escuro</item>
        <item name="colorOnBackground">@color/on_bg_escuro</item>

        <!-- Cores de Texto -->
        <item name="android:textColorPrimary">@color/on_bg_escuro</item>
        <item name="android:textColorSecondary">@color/text_secondary_escuro</item>

        <!-- Fonte Padrão para todo o App -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

</resources>