<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Aurora" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores Primárias, Secundárias e Terciárias (Material 3 - Modo Escuro) -->
        <item name="colorPrimary">@color/cor_primaria</item>
        <item name="colorOnPrimary">#000000</item>

        <item name="colorSecondary">@color/cor_segundaria</item>
        <item name="colorOnSecondary">#000000</item>

        <item name="colorTertiary">@color/cor_terciaria</item>
        <item name="colorOnTertiary">#000000</item>

        <!-- Fundos, Superfícies e Bordas (Chaves Unificadas) -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Cor da borda para TextInputLayouts Outlined e Cards M3 -->
        <item name="colorOutline">@color/cor_borda</item>

        <!-- Cores de Texto Padrão -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Fonte Padrão do Aplicativo -->
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="Theme.Aurora" parent="Base.Theme.Aurora" />

    <!-- Corpo de Texto / Inputs / Rótulos (Inter Regular) -->
    <style name="TextAppearance.Aurora.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/inter</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textFontWeight">400</item>
    </style>
    <!--Cor contato card-->
    <color name="contatocard">#475052</color>
    <color name="bordacontatocard">#1B1818</color>
</resources>